
# ==========================================
# MEYAR - PRODUCTION CONFIGURATION
# www.sekemeyar.com
# ==========================================

Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # --------------------------------------
    # 1. Security
    # --------------------------------------

    # Block development and Git directories
    RewriteRule (^|/)\.(git|github|specify)(/|$) - [F,L,NC]

    # Block environment files
    RewriteRule (^|/)\.env(\..*)?$ - [F,L,NC]

    # Block database, backup and log files
    RewriteRule \.(bak|backup|sql|sqlite|sqlite3|db|log|zip|tar|gz)$ - [F,L,NC]

    # Protect private application directories
    RewriteRule ^(data|inc)/ - [F,L,NC]

    # --------------------------------------
    # 2. Canonical domain and HTTPS
    # --------------------------------------

    RewriteCond %{HTTPS} !=on [OR]
    RewriteCond %{HTTP_HOST} !^www\.sekemeyar\.com$ [NC]
    RewriteRule ^ https://www.sekemeyar.com%{REQUEST_URI} [R=301,L,NE]

    # --------------------------------------
    # 3. Market pages
    # --------------------------------------

    RewriteRule ^prices/?$ prices.php [L,QSA]

    RewriteRule ^prices/gold/?$ prices.php?market=gold [L,QSA]
    RewriteRule ^prices/coin/?$ prices.php?market=coins [L,QSA]
    RewriteRule ^prices/coins/?$ prices.php?market=coins [L,QSA]
    RewriteRule ^prices/currency/?$ prices.php?market=currency [L,QSA]
    RewriteRule ^prices/silver/?$ prices.php?market=silver [L,QSA]

    # --------------------------------------
    # 4. Individual price pages
    # --------------------------------------

    RewriteRule ^price/([a-zA-Z0-9_-]+)/?$ price.php?id=$1 [L,QSA]

    # --------------------------------------
    # 5. TV display
    # --------------------------------------

    RewriteRule ^tv/?$ tv.php [L,QSA]

    # --------------------------------------
    # 6. XML Sitemap
    # --------------------------------------

    RewriteRule ^sitemap\.xml$ sitemap.php [L,QSA]

</IfModule>

# ==========================================
# 7. Security headers
# ==========================================

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# ==========================================
# 8. Compression
# ==========================================

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml text/xml image/svg+xml
</IfModule>

# ==========================================
# 9. Browser caching
# ==========================================

<IfModule mod_expires.c>
    ExpiresActive On

    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"

    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/x-icon "access plus 30 days"

    ExpiresByType font/woff "access plus 30 days"
    ExpiresByType font/woff2 "access plus 30 days"
</IfModule>

# ==========================================
# 10. Production public URL
# ==========================================

<IfModule mod_env.c>
    SetEnv MEYAR_PUBLIC_URL "https://www.sekemeyar.com"
</IfModule>
